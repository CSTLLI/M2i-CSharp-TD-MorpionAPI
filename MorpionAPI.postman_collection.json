{
  "info": {
    "name": "Morpion API",
    "description": "API Morpion (Tic-Tac-Toe) C# .NET 10 — Humain vs Humain / Humain vs Bot.\n\nPositions: 1-9 (1 = haut-gauche, 5 = centre, 9 = bas-droite).\n\nFlow:\n1. Créer une partie (POST /games) → l'ID est stocké automatiquement dans la variable `gameId`.\n2. Récupérer la partie (GET /games/{{gameId}}).\n3. Jouer un coup (POST /games/{{gameId}}/moves).\n4. Consulter l'historique (GET /history).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5069",
      "type": "string"
    },
    {
      "key": "gameId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Create game (Human vs Human)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "const json = pm.response.json();",
              "pm.collectionVariables.set('gameId', json.id);",
              "console.log('gameId =', json.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"mode\": \"HumanVsHuman\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/games",
          "host": ["{{baseUrl}}"],
          "path": ["games"]
        }
      }
    },
    {
      "name": "Create game (Human vs Bot)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "const json = pm.response.json();",
              "pm.collectionVariables.set('gameId', json.id);",
              "console.log('gameId =', json.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"mode\": \"HumanVsBot\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/games",
          "host": ["{{baseUrl}}"],
          "path": ["games"]
        }
      }
    },
    {
      "name": "Get current game",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/games/{{gameId}}",
          "host": ["{{baseUrl}}"],
          "path": ["games", "{{gameId}}"]
        }
      }
    },
    {
      "name": "Play move (position 1-9)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "console.log('Board:', json.board, '| Next:', json.currentPlayer, '| Status:', json.status);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"position\": 5\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/games/{{gameId}}/moves",
          "host": ["{{baseUrl}}"],
          "path": ["games", "{{gameId}}", "moves"]
        }
      }
    },
    {
      "name": "Get history",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/history",
          "host": ["{{baseUrl}}"],
          "path": ["history"]
        }
      }
    }
  ]
}
